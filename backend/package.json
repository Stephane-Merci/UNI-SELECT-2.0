{
  "name": "backend",
  "version": "1.0.0",
  "description": "Worker Management API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && node scripts/copy-generated.js",
    "migrate:deploy": "node scripts/prisma-migrate-deploy.cjs",
    "start": "node dist/index.js",
    "start:prod": "npm run migrate:deploy && node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:plan": "prisma migrate dev --name add_plan_system",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.1",
    "prisma": "^5.7.1",
    "socket.io": "^4.5.4",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^7.0.10",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
