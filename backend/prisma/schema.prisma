generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Worker {
  id                   String               @id @default(cuid())
  anciennete           String               @unique(map: "Worker_matricule_key")
  name                 String
  type                 WorkerType           @default(PERMANENT_JOUR)
  originalPostId       String
  /// Weekly pre-retirement day (e.g. MONDAY–FRIDAY). When a plan's date matches this weekday,
  /// the worker is automatically marked as PRERETRAITE for that plan.
  preRetraiteDay       String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  absenceStartDate     DateTime?
  absenceEndDate       DateTime?
  assignments          Assignment[]
  bookingAssignments   BookingAssignment[]
  bookingReplacements1 BookingReplacement[] @relation("Replacement1")
  bookingReplacements2 BookingReplacement[] @relation("Replacement2")
  bookingReplacements3 BookingReplacement[] @relation("Replacement3")
  bookingReplacements4 BookingReplacement[] @relation("Replacement4")
  bookingReplacements5 BookingReplacement[] @relation("Replacement5")
  bookingReplacements6 BookingReplacement[] @relation("Replacement6")
  bookingReplacements7 BookingReplacement[] @relation("Replacement7")
  bookingReplacements8 BookingReplacement[] @relation("Replacement8")
  originalPost         Post                 @relation("OriginalPost", fields: [originalPostId], references: [id])
  presences            WorkerPresence[]

  @@index([type])
  @@index([anciennete], map: "Worker_matricule_idx")
}

model Post {
  id                  String               @id @default(cuid())
  name                String
  description         String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  assignments         Assignment[]
  bookingAssignments  BookingAssignment[]
  bookingReplacements BookingReplacement[]
  originalWorkers     Worker[]             @relation("OriginalPost")
  unfilledPositions   UnfilledPosition[]

  @@index([name])
}

model Plan {
  id              String           @id @default(cuid())
  name            String
  date            DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
  createdBy       String?
  assignments     Assignment[]
  workerPresences WorkerPresence[]
  unfilledPositions UnfilledPosition[]

  @@index([name])
  @@index([date])
}

model UnfilledPosition {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([planId])
  @@index([postId])
}

model Assignment {
  id         String   @id @default(cuid())
  workerId   String
  postId     String
  assignedAt DateTime @default(now())
  assignedBy String?
  planId     String
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([planId, workerId])
  @@unique([workerId, postId, assignedAt])
  @@index([planId])
  @@index([workerId])
  @@index([postId])
}

model WorkerPresence {
  id        String     @id @default(cuid())
  planId    String
  workerId  String
  type      WorkerType
  updatedAt DateTime   @default(now()) @updatedAt
  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  worker    Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([planId, workerId])
  @@index([planId])
  @@index([workerId])
  @@index([type])
}

model Booking {
  id            String               @id @default(cuid())
  name          String
  effectiveDate DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  isActive      Boolean              @default(false)
  assignments   BookingAssignment[]
  replacements  BookingReplacement[]

  @@index([effectiveDate])
}

model BookingAssignment {
  id        String  @id @default(cuid())
  bookingId String
  workerId  String
  postId    String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([bookingId, workerId])
  @@index([bookingId])
}

model BookingReplacement {
  id                   String  @id @default(cuid())
  bookingId            String
  postId               String
  replacement1WorkerId String?
  replacement2WorkerId String?
  replacement3WorkerId String?
  replacement4WorkerId String?
  replacement5WorkerId String?
  replacement6WorkerId String?
  replacement7WorkerId String?
  replacement8WorkerId String?
  booking              Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  post                 Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  replacement1Worker   Worker? @relation("Replacement1", fields: [replacement1WorkerId], references: [id])
  replacement2Worker   Worker? @relation("Replacement2", fields: [replacement2WorkerId], references: [id])
  replacement3Worker   Worker? @relation("Replacement3", fields: [replacement3WorkerId], references: [id])
  replacement4Worker   Worker? @relation("Replacement4", fields: [replacement4WorkerId], references: [id])
  replacement5Worker   Worker? @relation("Replacement5", fields: [replacement5WorkerId], references: [id])
  replacement6Worker   Worker? @relation("Replacement6", fields: [replacement6WorkerId], references: [id])
  replacement7Worker   Worker? @relation("Replacement7", fields: [replacement7WorkerId], references: [id])
  replacement8Worker   Worker? @relation("Replacement8", fields: [replacement8WorkerId], references: [id])

  @@unique([bookingId, postId])
  @@index([bookingId])
}

model Manager {
  id               String   @id @default(cuid())
  username         String   @unique
  email            String?  @unique
  passwordHash     String
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([username])
  @@index([email])
}

enum WorkerType {
  JOUR
  SOIR
  ABSENT
  OCCASIONEL_DU_JOUR
  OCCASIONEL_SOIR
  VACANCES
  LIBERATION_EXTERNE
  INVALIDITE
  PRERETRAITE
  CONGE_PARENTAL
  PERMANENT_JOUR
  PERMANENT_SOIR
  MOBILITE_DU_JOUR
  MOBILITE_DU_SOIR
}
